# Environment Variables
# Copie este arquivo para .env.local e preencha os valores

# ============================================
# DATABASE - Supabase ou PostgreSQL local
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/recombo?schema=public"

# ============================================
# SUPABASE (opcional - para autenticação e storage)
# ============================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# UPLOAD (para implementação futura)
# ============================================
# NEXT_PUBLIC_UPLOAD_MAX_SIZE=500000000
# UPLOAD_DESTINATION="local" # ou "supabase"