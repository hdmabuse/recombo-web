# Environment Variables
# Copie este arquivo para .env.local e preencha os valores

# ============================================
# DATABASE - Supabase ou PostgreSQL local
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/recombo?schema=public"

# ============================================
# ARCHIVEBOX - acervo de capturas web
# ============================================
# ATENÇÃO: sem prefixo NEXT_PUBLIC_ — o token nunca vai ao browser.
ARCHIVEBOX_URL="http://192.168.68.110:8030"
ARCHIVEBOX_TOKEN=""
# tag que define a coleção exibida na curadoria
ARCHIVEBOX_TAG="col:recombo"

# ============================================
# ÁREA DE CURADORIA - login
# ============================================
# Sessão assinada com HMAC; troque AUTH_SECRET por uma string aleatória longa:
#   openssl rand -hex 32
ADMIN_EMAIL="mabuse@recombo.art.br"
ADMIN_PASSWORD="troque-esta-senha"
AUTH_SECRET=""

# ============================================
# SUPABASE (opcional - para autenticação e storage)
# ============================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# UPLOAD (para implementação futura)
# ============================================
# NEXT_PUBLIC_UPLOAD_MAX_SIZE=500000000
# UPLOAD_DESTINATION="local" # ou "supabase"